# Example only. Recommended: run scripts/configure_runtime.sh.
# The real file is stored outside the project at:
#   ~/.config/loto-ops/runtime.env
LOTO_NOTIFY_ENABLED=1
LOTO_NOTIFY_ON_SUCCESS=1
LOTO_NOTIFY_ON_FAILURE=1
LOTO_NOTIFY_EMAIL_ENABLED=1
LOTO_NOTIFY_EMAIL_TO=your-address@gmail.com
LOTO_NOTIFY_EMAIL_FROM=your-address@gmail.com
LOTO_NOTIFY_SMTP_HOST=smtp.gmail.com
LOTO_NOTIFY_SMTP_PORT=587
LOTO_NOTIFY_SMTP_STARTTLS=1
LOTO_NOTIFY_SMTP_USER=your-address@gmail.com
LOTO_NOTIFY_SMTP_PASSWORD=${LOTO_NOTIFY_SMTP_PASSWORD}
LOTO_NOTIFY_SLACK_ENABLED=1
LOTO_NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME
