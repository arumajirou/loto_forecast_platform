{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loto.local/schemas/003/proposal.schema.json",
  "title": "Proposal",
  "description": "An experiment configuration. This is the ONLY surface a proposer may set. Fields feeding kpi_definition_hash or the evaluation protocol are structurally absent so no proposer can move the goalposts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["point_method"],
  "properties": {
    "point_method": {"type": "string", "enum": ["last", "mean", "median", "ewm", "rolling_mean", "seasonal_naive", "drift"]},
    "window": {"type": "integer", "minimum": 2, "maximum": 500},
    "halflife": {"type": "number", "minimum": 0.5, "maximum": 200.0},
    "pool_size": {"type": "integer", "minimum": 10, "maximum": 200000},
    "per_position_top": {"type": "integer", "minimum": 1, "maximum": 40},
    "beam_width": {"type": "integer", "minimum": 1, "maximum": 200000},
    "diversity_penalty": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "residual_scale": {"type": "number", "minimum": 0.0, "maximum": 10.0},
    "selection": {"type": "string", "enum": ["greedy_max", "greedy_min_cover", "topk"]},
    "proposal_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "rationale": {"type": "string", "maxLength": 500, "description": "Recorded for audit. Never affects acceptance."}
  }
}
